{
  "name": "leoos",
  "version": "1.0.0",
  "description": "LEOOS — the operating system of the Arcane empire.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "node build.js",
    "dev": "npx --yes serve . -l 5173",
    "vault": "node tools/vault.js",
    "test": "bash test/run.sh",
    "test:contrast": "bash test/run.sh --contrast",
    "test:clipping": "bash test/run.sh --clipping",
    "test:dev": "bash test/run.sh --dev",
    "test:store": "bash test/run.sh --store",
    "test:forge": "bash test/run.sh --forge",
    "test:vault": "bash test/run.sh --vault",
    "deploy": "firebase deploy --only hosting,firestore:rules",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}
